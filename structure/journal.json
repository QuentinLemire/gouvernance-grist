{
  "format": "grist-structure",
  "version": "1.3",
  "sujet": "JOURNAL",
  "tables": [
    {
      "tableId": "Journal_Admin",
      "columns": [
        {
          "id": "Date",
          "label": "Date",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 0
        },
        {
          "id": "Personne",
          "label": "Auteur (fiche)",
          "type": "Ref:Utilisateurs",
          "isFormula": true,
          "formula": "Utilisateurs.lookupOne(Email_cle=($Auteur or \"\").strip().lower()) or None",
          "visibleCol": "Email"
        },
        {
          "id": "Action",
          "label": "Action",
          "type": "Text"
        },
        {
          "id": "Detail",
          "label": "Détail",
          "type": "Text"
        },
        {
          "id": "Auteur",
          "label": "Auteur",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 0
        }
      ]
    }
  ],
  "dependances": [
    "UTILISATEURS"
  ]
}
