{
  "format": "grist-structure",
  "version": "3.0",
  "sujet": "JOURNAL",
  "description": "Journal de toutes les modifications du document : une ligne par changement (ajout, modification avec l'ancienne et la nouvelle valeur, suppression, structure), relevé par le widget de la page 📒 Journal à chaque ouverture (sans n8n), plus les actions des outils d'administration.",
  "tables": [
    {
      "tableId": "Gouv_Journal",
      "columns": [
        {
          "id": "Date",
          "label": "Date",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 0
        },
        {
          "id": "Auteur",
          "label": "Auteur",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 0
        },
        {
          "id": "Action",
          "label": "Action",
          "type": "Text"
        },
        {
          "id": "Table",
          "label": "Table",
          "type": "Text"
        },
        {
          "id": "Ligne",
          "label": "Ligne",
          "type": "Int"
        },
        {
          "id": "Colonne",
          "label": "Colonne",
          "type": "Text"
        },
        {
          "id": "Avant",
          "label": "Avant",
          "type": "Text"
        },
        {
          "id": "Apres",
          "label": "Après",
          "type": "Text"
        },
        {
          "id": "Detail",
          "label": "Détail",
          "type": "Text"
        },
        {
          "id": "Personne",
          "label": "Auteur (fiche)",
          "type": "Ref:Gouv_Utilisateurs",
          "isFormula": true,
          "formula": "Gouv_Utilisateurs.lookupOne(Courriel_cle=($Auteur or \"\").strip().lower()) or None",
          "visibleCol": "Courriel"
        },
        {
          "id": "Etat",
          "label": "État du document",
          "type": "Int"
        }
      ]
    }
  ],
  "dependances": [
    "UTILISATEURS"
  ]
}
