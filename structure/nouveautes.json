{
  "format": "grist-structure",
  "version": "1.1",
  "sujet": "NOUVEAUTES",
  "description": "Journal des nouveautés de l'application, lisible par les utilisateurs (inspiré de « SuiviDesModifications » d'OPCOM).",
  "tables": [
    {
      "tableId": "Nouveautes",
      "columns": [
        {
          "id": "Date",
          "label": "Date",
          "type": "Date",
          "formula": "TODAY()",
          "recalcWhen": 0
        },
        {
          "id": "Version",
          "label": "Version",
          "type": "Text"
        },
        {
          "id": "Titre",
          "label": "Titre",
          "type": "Text"
        },
        {
          "id": "Detail",
          "label": "Détail",
          "type": "Text",
          "widgetOptions": {
            "widget": "Markdown",
            "wrap": true
          }
        },
        {
          "id": "Impact",
          "label": "Impact pour les utilisateurs",
          "type": "Choice",
          "widgetOptions": {
            "choices": [
              "Aucun",
              "Nouvelle fonction",
              "Changement d'usage",
              "Action requise"
            ],
            "choiceOptions": {
              "Aucun": {
                "fillColor": "#EEEEEE",
                "textColor": "#000000"
              },
              "Nouvelle fonction": {
                "fillColor": "#C3FAD5",
                "textColor": "#000000"
              },
              "Changement d'usage": {
                "fillColor": "#FEECC2",
                "textColor": "#000000"
              },
              "Action requise": {
                "fillColor": "#FFBDBD",
                "textColor": "#000000"
              }
            }
          }
        },
        {
          "id": "CreeLe",
          "label": "Créé le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 0
        },
        {
          "id": "CreePar",
          "label": "Créé par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 0
        },
        {
          "id": "ModifieLe",
          "label": "Modifié le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 2
        },
        {
          "id": "ModifiePar",
          "label": "Modifié par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 2
        }
      ]
    }
  ]
}
