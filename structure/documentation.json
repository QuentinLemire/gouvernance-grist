{
  "format": "grist-structure",
  "version": "1.4",
  "sujet": "DOCUMENTATION",
  "description": "Pages de documentation, FAQ, notes et nouveautés (rubrique « Nouveauté », affichées sur l'accueil), en Markdown.",
  "tables": [
    {
      "tableId": "Documentation",
      "columns": [
        {
          "id": "Titre",
          "label": "Titre",
          "type": "Text"
        },
        {
          "id": "Rubrique",
          "label": "Rubrique",
          "type": "Choice",
          "widgetOptions": {
            "choices": [
              "Nouveauté",
              "Norme",
              "Guide utilisateur",
              "Procédure",
              "FAQ",
              "Note",
              "Compte rendu",
              "Décision"
            ],
            "choiceOptions": {
              "Guide utilisateur": {
                "fillColor": "#E3E3FD",
                "textColor": "#000000"
              },
              "Procédure": {
                "fillColor": "#C3FAD5",
                "textColor": "#000000"
              },
              "FAQ": {
                "fillColor": "#FEECC2",
                "textColor": "#000000"
              },
              "Note": {
                "fillColor": "#EEEEEE",
                "textColor": "#000000"
              },
              "Compte rendu": {
                "fillColor": "#CADDFB",
                "textColor": "#000000"
              },
              "Décision": {
                "fillColor": "#000091",
                "textColor": "#FFFFFF"
              },
              "Norme": {
                "fillColor": "#000091",
                "textColor": "#FFFFFF"
              },
              "Nouveauté": {
                "fillColor": "#B8FEC9",
                "textColor": "#000000"
              }
            }
          }
        },
        {
          "id": "Ordre",
          "label": "Ordre",
          "type": "Numeric"
        },
        {
          "id": "Contenu",
          "label": "Contenu",
          "type": "Text",
          "widgetOptions": {
            "widget": "Markdown",
            "wrap": true
          }
        },
        {
          "id": "CreeLe",
          "label": "Créé le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 0
        },
        {
          "id": "CreePar",
          "label": "Créé par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 0
        },
        {
          "id": "Auteur",
          "label": "Auteur (fiche)",
          "type": "Ref:Utilisateurs",
          "isFormula": true,
          "formula": "Utilisateurs.lookupOne(Email_cle=($CreePar or \"\").strip().lower()) or None",
          "visibleCol": "Email"
        },
        {
          "id": "ModifieLe",
          "label": "Modifié le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 2
        },
        {
          "id": "ModifiePar",
          "label": "Modifié par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 2
        }
      ]
    }
  ],
  "dependances": [
    "UTILISATEURS"
  ]
}
