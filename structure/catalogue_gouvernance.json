                "fillColor": "#FEECC2",
                "textColor": "#000000"
              },
              "Traçabilité": {
                "fillColor": "#E3E3FD",
                "textColor": "#000000"
              },
              "Paramétrage": {
                "fillColor": "#EEEEEE",
                "textColor": "#000000"
              },
              "Référentiel": {
                "fillColor": "#C3FAD5",
                "textColor": "#000000"
              }
            }
          }
        },
        {
          "id": "Version",
          "label": "Version",
          "type": "Text",
          "formula": "\"1.0\"",
          "recalcWhen": 0
        },
        {
          "id": "Statut",
          "label": "Statut",
          "type": "Choice",
          "formula": "\"Brouillon\"",
          "recalcWhen": 0,
          "widgetOptions": {
            "choices": [
              "Brouillon",
              "Validé",
              "Obsolète"
            ],
            "choiceOptions": {
              "Brouillon": {
                "fillColor": "#EEEEEE",
                "textColor": "#000000"
              },
              "Validé": {
                "fillColor": "#C3FAD5",
                "textColor": "#000000"
              },
              "Obsolète": {
