          "visibleCol": "Email"
        },
        {
          "id": "Chemin_Git",
          "label": "Fichier sur Git",
          "type": "Text",
          "isFormula": true,
          "formula": "return \"structure/%s.json\" % (rec.Code or \"\").lower()"
        },
        {
          "id": "Tables",
          "label": "Tables",
          "type": "RefList:Structure_tables",
          "isFormula": true,
          "formula": "Structure_tables.lookupRecords(Sujet=rec.id)"
        },
        {
          "id": "Nb_applications",
          "label": "Nb applications",
          "type": "Numeric",
          "isFormula": true,
          "formula": "return len(Applications.lookupRecords(Sujets=CONTAINS(rec.id)))"
        },
        {
          "id": "CreeLe",
          "label": "Créé le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 0
        },
        {
          "id": "CreePar",
          "label": "Créé par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 0
        },
        {
