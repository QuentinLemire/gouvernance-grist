{
  "format": "grist-structure",
  "version": "2.1",
  "sujet": "BUREAUX_DGOM",
  "description": "Les directions, sous-directions et bureaux de la DGOM (sigle, rattachement, courriel du secrétariat, couleur), avec la page 🏢 Organigramme qui se dessine toute seule à partir de cette table. Données de départ reprises de l'Outil cabDG, avec les mêmes identifiants.",
  "tables": [
    {
      "tableId": "Gouv_Bureaux",
      "columns": [
        {
          "id": "Identifiant",
          "label": "Identifiant",
          "type": "Int",
          "isFormula": true,
          "formula": "# Numéro stable de la ligne (le même que dans l'Outil cabDG) : à utiliser pour relier un autre document\nreturn $id"
        },
        {
          "id": "Nom",
          "label": "Nom",
          "type": "Text"
        },
        {
          "id": "Parent",
          "label": "Rattaché à",
          "type": "Ref:Gouv_Bureaux",
          "visibleCol": "Nom"
        },
        {
          "id": "Nom_complet",
          "label": "Nom complet",
          "type": "Text",
          "isFormula": true,
          "formula": "# Chemin depuis la direction : « DGOM/SDEPDE/BSSIOM »\nnom = $Nom\nparent = $Parent\nwhile parent:\n    nom = parent.Nom + \"/\" + nom\n    parent = parent.Parent\nreturn nom"
        },
        {
          "id": "Courriel",
          "label": "Courriel",
          "type": "Text"
        },
        {
          "id": "Couleur",
          "label": "Couleur (organigramme)",
          "type": "Text"
        },
        {
