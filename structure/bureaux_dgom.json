{
  "format": "grist-structure",
  "version": "2.1",
  "sujet": "BUREAUX_DGOM",
  "description": "Remplit les Entités avec les directions, sous-directions et bureaux de la DGOM (rattachement, courriel du secrétariat, couleur, identifiant de l'Outil cabDG) et ajoute la page 🏢 Organigramme, dessinée à partir des Entités et des Utilisateurs (chef, adjoint, membres : colonne Utilisateurs.Encadrement, vide = agent). Une entité déjà présente (même nom) est complétée, jamais remplacée.",
  "tables": [
    {
      "tableId": "Gouv_Entites",
      "extension": true,
      "columns": [
        {
          "id": "Id_DGOM",
          "label": "Identifiant DGOM",
          "type": "Int"
        },
        {
          "id": "Courriel",
          "label": "Courriel",
          "type": "Text"
        },
        {
          "id": "Couleur",
          "label": "Couleur (organigramme)",
          "type": "Text"
        },
        {
          "id": "Organigramme",
          "label": "Dans l'organigramme",
          "type": "Bool",
          "formula": "True"
        }
      ]
    },
    {
      "tableId": "Gouv_Utilisateurs",
      "extension": true,
      "columns": [
        {
          "id": "Encadrement",
          "label": "Encadrement",
          "type": "Choice",
          "widgetOptions": {
            "choices": [
              "Directeur",
              "Directeur adjoint",
              "Sous-directeur",
              "Sous-directeur adjoint",
              "Chef de bureau",
              "Adjoint au chef de bureau",
              "Chef de mission",
              "Adjoint au chef de mission"
            ]
          }
        }
      ]
    }
  ],
  "dependances": [
    "UTILISATEURS"
  ]
}