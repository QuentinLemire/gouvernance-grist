{
  "format": "grist-structure",
  "version": "1.5",
  "sujet": "UTILISATEURS",
  "description": "Annuaire et rôles génériques (Administrateur, Gestionnaire, Contributeur, Lecteur), arborescence des services ; base des droits.",
  "tables": [
    {
      "tableId": "Entites",
      "columns": [
        {
          "id": "Nom",
          "label": "Nom",
          "type": "Text"
        },
        {
          "id": "Parent",
          "label": "Parent",
          "type": "Ref:Entites",
          "visibleCol": "Nom"
        },
        {
          "id": "Nom_complet",
          "label": "Nom complet",
          "type": "Text",
          "isFormula": true,
          "formula": "nom = rec.Nom\nparent = rec.Parent\nwhile parent:\n    nom = parent.Nom + \"/\" + nom\n    parent = parent.Parent\nreturn nom"
        },
        {
          "id": "Territoire",
          "label": "Territoire",
          "type": "Ref:Territoires",
          "visibleCol": "Nom"
        },
        {
          "id": "Actif",
          "label": "Actif",
          "type": "Bool",
          "formula": "True",
          "recalcWhen": 0
        },
        {
          "id": "Membres",
          "label": "Membres",
          "type": "RefList:Utilisateurs",
          "isFormula": true,
          "formula": "Utilisateurs.lookupRecords(Entite=$id, sort_by=\"Nom\")",
          "visibleCol": "Email"
        },
        {
          "id": "Nbre",
          "label": "Nb utilisateurs",
          "type": "Numeric",
          "isFormula": true,
          "formula": "return len(Utilisateurs.lookupRecords(Entite=rec.id, Actif=True))"
        },
        {
          "id": "CreeLe",
          "label": "Créé le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 0
        },
        {
          "id": "CreePar",
          "label": "Créé par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 0
        },
        {
          "id": "ModifieLe",
          "label": "Modifié le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 2
        },
        {
          "id": "ModifiePar",
          "label": "Modifié par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 2
        }
      ]
    },
    {
      "tableId": "Utilisateurs",
      "columns": [
        {
          "id": "Nom",
          "label": "Nom",
          "type": "Text"
        },
        {
          "id": "Email",
          "label": "Email",
          "type": "Text"
        },
        {
          "id": "Entite",
          "label": "Entité",
          "type": "Ref:Entites",
          "visibleCol": "Nom"
        },
        {
          "id": "Role",
          "label": "Rôle",
          "type": "Choice",
          "widgetOptions": {
            "choices": [
              "Administrateur",
              "Gestionnaire",
              "Contributeur",
              "Lecteur"
            ],
            "choiceOptions": {
              "Administrateur": {
                "fillColor": "#000091",
                "textColor": "#FFFFFF"
              },
              "Gestionnaire": {
                "fillColor": "#6A6AF4",
                "textColor": "#FFFFFF"
              },
              "Contributeur": {
                "fillColor": "#C3FAD5",
                "textColor": "#000000"
              },
              "Lecteur": {
                "fillColor": "#E3E3FD",
                "textColor": "#000000"
              }
            }
          }
        },
        {
          "id": "Actif",
          "label": "Actif",
          "type": "Bool",
          "formula": "True",
          "recalcWhen": 0
        },
        {
          "id": "Email_cle",
          "label": "Clé email (technique)",
          "type": "Text",
          "isFormula": true,
          "formula": "($Email or \"\").strip().lower()"
        },
        {
          "id": "Courriel_valide",
          "label": "Courriel valide",
          "type": "Bool",
          "isFormula": true,
          "formula": "import re\nreturn bool(re.match(r\"^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$\", $Email_cle))"
        },
        {
          "id": "Doublon",
          "label": "Doublon",
          "type": "Bool",
          "isFormula": true,
          "formula": "return bool($Email_cle) and len(Utilisateurs.lookupRecords(Email_cle=$Email_cle)) > 1"
        },
        {
          "id": "CreeLe",
          "label": "Créé le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 0
        },
        {
          "id": "CreePar",
          "label": "Créé par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 0
        },
        {
          "id": "ModifieLe",
          "label": "Modifié le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 2
        },
        {
          "id": "ModifiePar",
          "label": "Modifié par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 2
        }
      ]
    }
  ],
  "dependances": [
    "REFERENTIEL_TERRITOIRES"
  ]
}
