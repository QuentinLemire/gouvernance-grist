{
  "format": "grist-structure",
  "version": "2.1",
  "sujet": "UTILISATEURS",
  "description": "Annuaire et rôles génériques (Administrateur, Gestionnaire, Contributeur, Lecteur), arborescence des services ; base des droits.",
  "tables": [
    {
      "tableId": "Gouv_Entites",
      "columns": [
        {
          "id": "Nom",
          "label": "Nom",
          "type": "Text"
        },
        {
          "id": "Parent",
          "label": "Parent",
          "type": "Ref:Gouv_Entites",
          "visibleCol": "Nom"
        },
        {
          "id": "Nom_complet",
          "label": "Nom complet",
          "type": "Text",
          "isFormula": true,
          "formula": "nom = rec.Nom\nparent = rec.Parent\nwhile parent:\n    nom = parent.Nom + \"/\" + nom\n    parent = parent.Parent\nreturn nom"
        },
        {
          "id": "Actif",
          "label": "Actif",
          "type": "Bool",
          "formula": "True",
          "recalcWhen": 0
        },
        {
          "id": "Membres",
          "label": "Membres",
          "type": "RefList:Gouv_Utilisateurs",
          "isFormula": true,
          "formula": "Gouv_Utilisateurs.lookupRecords(Entite=$id, sort_by=\"Nom\")",
          "visibleCol": "Courriel"
        },
        {
          "id": "Nbre",
          "label": "Nb utilisateurs",
          "type": "Numeric",
          "isFormula": true,
          "formula": "return len(Gouv_Utilisateurs.lookupRecords(Entite=rec.id, Actif=True))"
        },
        {
          "id": "CreeLe",
          "label": "Créé le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 0
        },
        {
          "id": "CreePar",
          "label": "Créé par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 0
        },
        {
          "id": "ModifieLe",
          "label": "Modifié le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 2
        },
        {
          "id": "ModifiePar",
          "label": "Modifié par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 2
        }
      ]
    },
    {
      "tableId": "Gouv_Utilisateurs",
      "columns": [
        {
          "id": "Nom",
          "label": "Nom",
          "type": "Text"
        },
        {
          "id": "Courriel",
          "label": "Courriel",
          "type": "Text"
        },
        {
          "id": "Entite",
          "label": "Entité",
          "type": "Ref:Gouv_Entites",
          "visibleCol": "Nom"
        },
        {
          "id": "Perimetre",
          "label": "Périmètre (autres entités)",
          "type": "RefList:Gouv_Entites",
          "visibleCol": "Nom"
        },
        {
          "id": "Entites_vues",
          "label": "Entités vues",
          "type": "RefList:Gouv_Entites",
          "isFormula": true,
          "formula": "# Entité principale + périmètre, avec toutes leurs sous-entités (hiérarchie Parent)\nvues = set()\na_voir = [e for e in [$Entite] + list($Perimetre) if e]\nwhile a_voir:\n    e = a_voir.pop()\n    if e.id not in vues:\n        vues.add(e.id)\n        a_voir.extend(Gouv_Entites.lookupRecords(Parent=e.id))\nreturn sorted(vues)",
          "visibleCol": "Nom"
        },
        {
          "id": "Role",
          "label": "Rôle",
          "type": "Choice",
          "widgetOptions": {
            "choices": [
              "Administrateur",
              "Gestionnaire",
              "Contributeur",
              "Lecteur"
            ],
            "choiceOptions": {
              "Administrateur": {
                "fillColor": "#000091",
                "textColor": "#FFFFFF"
              },
              "Gestionnaire": {
                "fillColor": "#6A6AF4",
                "textColor": "#FFFFFF"
              },
              "Contributeur": {
                "fillColor": "#C3FAD5",
                "textColor": "#000000"
              },
              "Lecteur": {
                "fillColor": "#E3E3FD",
                "textColor": "#000000"
              }
            }
          }
        },
        {
          "id": "Actif",
          "label": "Actif",
          "type": "Bool",
          "formula": "True",
          "recalcWhen": 0
        },
        {
          "id": "Courriel_cle",
          "label": "Clé email (technique)",
          "type": "Text",
          "isFormula": true,
          "formula": "($Courriel or \"\").strip().lower()"
        },
        {
          "id": "Courriel_valide",
          "label": "Courriel valide",
          "type": "Bool",
          "isFormula": true,
          "formula": "import re\nreturn bool(re.match(r\"^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$\", $Courriel_cle))"
        },
        {
          "id": "Doublon",
          "label": "Doublon",
          "type": "Bool",
          "isFormula": true,
          "formula": "return bool($Courriel_cle) and len(Gouv_Utilisateurs.lookupRecords(Courriel_cle=$Courriel_cle)) > 1"
        },
        {
          "id": "Acces_Grist",
          "label": "Accès Grist",
          "type": "Choice",
          "isFormula": true,
          "formula": "if not $Actif or not $Role:\n  return \"\"\n# Le Lecteur lit ; les autres rôles (dont les rôles métier) modifient\nreturn \"Lecteur\" if $Role == \"Lecteur\" else \"Éditeur\"",
          "widgetOptions": {
            "choices": [
              "Éditeur",
              "Lecteur"
            ],
            "choiceOptions": {
              "Éditeur": {
                "fillColor": "#6A6AF4",
                "textColor": "#FFFFFF"
              },
              "Lecteur": {
                "fillColor": "#E3E3FD",
                "textColor": "#000000"
              }
            }
          }
        },
        {
          "id": "CreeLe",
          "label": "Créé le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 0
        },
        {
          "id": "CreePar",
          "label": "Créé par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 0
        },
        {
          "id": "ModifieLe",
          "label": "Modifié le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 2
        },
        {
          "id": "ModifiePar",
          "label": "Modifié par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 2
        }
      ]
    }
  ]
}
