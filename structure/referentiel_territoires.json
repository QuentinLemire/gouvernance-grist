{
  "format": "grist-structure",
  "version": "1.4",
  "sujet": "REFERENTIEL_TERRITOIRES",
  "description": "Les 13 territoires ultramarins (code COG, statut, bassin). Données de référence fournies avec le modèle. Installé, ce sujet ajoute aussi la colonne Territoire aux Entités.",
  "tables": [
    {
      "tableId": "Territoires",
      "columns": [
        {
          "id": "Code_COG",
          "label": "Code COG",
          "type": "Text"
        },
        {
          "id": "Nom",
          "label": "Nom",
          "type": "Text"
        },
        {
          "id": "Chef_lieu",
          "label": "Chef-lieu",
          "type": "Text"
        },
        {
          "id": "Statut",
          "label": "Statut",
          "type": "Choice",
          "widgetOptions": {
            "choices": [
              "DROM",
              "COM",
              "Collectivité sui generis",
              "TAAF",
              "Domaine public de l'État"
            ],
            "choiceOptions": {
              "DROM": {
                "fillColor": "#000091",
                "textColor": "#FFFFFF"
              },
              "COM": {
                "fillColor": "#6A6AF4",
                "textColor": "#FFFFFF"
              },
              "Collectivité sui generis": {
                "fillColor": "#C3FAD5",
                "textColor": "#000000"
              },
              "TAAF": {
                "fillColor": "#E3E3FD",
                "textColor": "#000000"
              },
              "Domaine public de l'État": {
                "fillColor": "#EEEEEE",
                "textColor": "#000000"
              }
            }
          }
        },
        {
          "id": "Bassin",
          "label": "Bassin",
          "type": "Choice",
          "widgetOptions": {
            "choices": [
              "Atlantique",
              "Océan Indien",
              "Pacifique",
              "Austral"
            ],
            "choiceOptions": {
              "Atlantique": {
                "fillColor": "#CADDFB",
                "textColor": "#000000"
              },
              "Océan Indien": {
                "fillColor": "#C3FAD5",
                "textColor": "#000000"
              },
              "Pacifique": {
                "fillColor": "#FEECC2",
                "textColor": "#000000"
              },
              "Austral": {
                "fillColor": "#EEEEEE",
                "textColor": "#000000"
              }
            }
          }
        }
      ]
    },
    {
      "tableId": "Entites",
      "columns": [
        {
          "id": "Nom",
          "label": "Nom",
          "type": "Text"
        },
        {
          "id": "Parent",
          "label": "Parent",
          "type": "Ref:Entites",
          "visibleCol": "Nom"
        },
        {
          "id": "Nom_complet",
          "label": "Nom complet",
          "type": "Text",
          "isFormula": true,
          "formula": "nom = rec.Nom\nparent = rec.Parent\nwhile parent:\n    nom = parent.Nom + \"/\" + nom\n    parent = parent.Parent\nreturn nom"
        },
        {
          "id": "Territoire",
          "label": "Territoire",
          "type": "Ref:Territoires",
          "visibleCol": "Nom"
        },
        {
          "id": "Actif",
          "label": "Actif",
          "type": "Bool",
          "formula": "True",
          "recalcWhen": 0
        },
        {
          "id": "Membres",
          "label": "Membres",
          "type": "RefList:Utilisateurs",
          "isFormula": true,
          "formula": "Utilisateurs.lookupRecords(Entite=$id, sort_by=\"Nom\")",
          "visibleCol": "Email"
        },
        {
          "id": "Nbre",
          "label": "Nb utilisateurs",
          "type": "Numeric",
          "isFormula": true,
          "formula": "return len(Utilisateurs.lookupRecords(Entite=rec.id, Actif=True))"
        },
        {
          "id": "CreeLe",
          "label": "Créé le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 0
        },
        {
          "id": "CreePar",
          "label": "Créé par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 0
        },
        {
          "id": "ModifieLe",
          "label": "Modifié le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 2
        },
        {
          "id": "ModifiePar",
          "label": "Modifié par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 2
        }
      ]
    }
  ],
  "dependances": [
    "UTILISATEURS"
  ]
}
