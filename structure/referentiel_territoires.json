{
  "format": "grist-structure",
  "version": "3.0",
  "sujet": "REFERENTIEL_TERRITOIRES",
  "description": "Table des territoires ultramarins (code COG, statut, bassin), livrée vide : la norme ne publie que des structures. Installé, ce sujet ajoute aussi la colonne Territoire aux Utilisateurs (le territoire d'une personne hors MOM, saisi à la main), et les statistiques de Gouvernance comptent les utilisateurs par territoire.",
  "tables": [
    {
      "tableId": "Gouv_Territoires",
      "columns": [
        {
          "id": "Code_COG",
          "label": "Code COG",
          "type": "Text"
        },
        {
          "id": "Nom",
          "label": "Nom",
          "type": "Text"
        },
        {
          "id": "Chef_lieu",
          "label": "Chef-lieu",
          "type": "Text"
        },
        {
          "id": "Statut",
          "label": "Statut",
          "type": "Choice",
          "widgetOptions": {
            "choices": [
              "DROM",
              "COM",
              "Collectivité sui generis",
              "TAAF",
              "Domaine public de l'État"
            ],
            "choiceOptions": {
              "DROM": {
                "fillColor": "#000091",
                "textColor": "#FFFFFF"
              },
              "COM": {
                "fillColor": "#6A6AF4",
                "textColor": "#FFFFFF"
              },
              "Collectivité sui generis": {
                "fillColor": "#C3FAD5",
                "textColor": "#000000"
              },
              "TAAF": {
                "fillColor": "#E3E3FD",
                "textColor": "#000000"
              },
              "Domaine public de l'État": {
                "fillColor": "#EEEEEE",
                "textColor": "#000000"
              }
            }
          }
        },
        {
          "id": "Bassin",
          "label": "Bassin",
          "type": "Choice",
          "widgetOptions": {
            "choices": [
              "Atlantique",
              "Océan Indien",
              "Pacifique",
              "Austral"
            ],
            "choiceOptions": {
              "Atlantique": {
                "fillColor": "#CADDFB",
                "textColor": "#000000"
              },
              "Océan Indien": {
                "fillColor": "#C3FAD5",
                "textColor": "#000000"
              },
              "Pacifique": {
                "fillColor": "#FEECC2",
                "textColor": "#000000"
              },
              "Austral": {
                "fillColor": "#EEEEEE",
                "textColor": "#000000"
              }
            }
          }
        }
      ]
    },
    {
      "tableId": "Gouv_Utilisateurs",
      "extension": true,
      "columns": [
        {
          "id": "Territoire",
          "label": "Territoire",
          "type": "Ref:Gouv_Territoires",
          "visibleCol": "Nom"
        }
      ]
    }
  ],
  "dependances": [
    "UTILISATEURS"
  ]
}
