{
  "format": "grist-structure",
  "version": "1.2",
  "sujet": "SUPPORT",
  "description": "Demandes des utilisateurs, lien vers la page concernée, fil d'échanges et archivage.",
  "tables": [
    {
      "tableId": "Support",
      "columns": [
        {
          "id": "Titre",
          "label": "Titre",
          "type": "Text"
        },
        {
          "id": "Description",
          "label": "Description",
          "type": "Text"
        },
        {
          "id": "Categorie",
          "label": "Catégorie",
          "type": "Choice",
          "widgetOptions": {
            "choices": [
              "Accès / droits",
              "Anomalie",
              "Demande d'évolution",
              "Question"
            ],
            "choiceOptions": {}
          }
        },
        {
          "id": "Priorite",
          "label": "Priorité",
          "type": "Choice",
          "widgetOptions": {
            "choices": [
              "Basse",
              "Normale",
              "Haute",
              "Urgente"
            ],
            "choiceOptions": {
              "Basse": {
                "fillColor": "#E3E3FD",
                "textColor": "#000000"
              },
              "Normale": {
                "fillColor": "#C3FAD5",
                "textColor": "#000000"
              },
              "Haute": {
                "fillColor": "#FEECC2",
                "textColor": "#000000"
              },
              "Urgente": {
                "fillColor": "#FFBDBD",
                "textColor": "#000000"
              }
            }
          }
        },
        {
          "id": "Statut",
          "label": "Statut",
          "type": "Choice",
          "formula": "\"Nouveau\"",
          "recalcWhen": 0,
          "widgetOptions": {
            "choices": [
              "Nouveau",
              "En cours",
              "En attente",
              "Résolu",
              "Fermé"
            ],
            "choiceOptions": {
              "Nouveau": {
                "fillColor": "#E3E3FD",
                "textColor": "#000000"
              },
              "En cours": {
                "fillColor": "#FEECC2",
                "textColor": "#000000"
              },
              "En attente": {
                "fillColor": "#EEEEEE",
                "textColor": "#000000"
              },
              "Résolu": {
                "fillColor": "#C3FAD5",
                "textColor": "#000000"
              },
              "Fermé": {
                "fillColor": "#DDDDDD",
                "textColor": "#000000"
              }
            }
          }
        },
        {
          "id": "Demandeur",
          "label": "Demandeur",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 0
        },
        {
          "id": "Assigne_a",
          "label": "Assigné à",
          "type": "Ref:Utilisateurs",
          "visibleCol": "Email"
        },
        {
          "id": "Reponse",
          "label": "Réponse",
          "type": "Text"
        },
        {
          "id": "Url_page",
          "label": "Lien vers la page concernée",
          "type": "Text",
          "widgetOptions": {
            "widget": "HyperLink"
          }
        },
        {
          "id": "Archive",
          "label": "Archivé",
          "type": "Bool"
        },
        {
          "id": "Nb_commentaires",
          "label": "Nb échanges",
          "type": "Numeric",
          "isFormula": true,
          "formula": "return len(Support_commentaires.lookupRecords(Demande=$id))"
        },
        {
          "id": "Dernier_retour",
          "label": "Dernier échange",
          "type": "DateTime:Europe/Paris",
          "isFormula": true,
          "formula": "c = Support_commentaires.lookupRecords(Demande=$id, sort_by=\"CreeLe\")\nreturn c[-1].CreeLe if c else None"
        },
        {
          "id": "CreeLe",
          "label": "Créé le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 0
        },
        {
          "id": "CreePar",
          "label": "Créé par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 0
        },
        {
          "id": "ModifieLe",
          "label": "Modifié le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 2
        },
        {
          "id": "ModifiePar",
          "label": "Modifié par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 2
        }
      ]
    },
    {
      "tableId": "Support_commentaires",
      "columns": [
        {
          "id": "Demande",
          "label": "Demande",
          "type": "Ref:Support",
          "visibleCol": "Titre"
        },
        {
          "id": "Message",
          "label": "Message",
          "type": "Text"
        },
        {
          "id": "Type",
          "label": "Type",
          "type": "Choice",
          "widgetOptions": {
            "choices": [
              "Message",
              "Événement"
            ]
          },
          "formula": "\"Message\"",
          "isFormula": false,
          "recalcWhen": 0
        },
        {
          "id": "CreeLe",
          "label": "Créé le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 0
        },
        {
          "id": "CreePar",
          "label": "Créé par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 0
        },
        {
          "id": "ModifieLe",
          "label": "Modifié le",
          "type": "DateTime:Europe/Paris",
          "formula": "NOW()",
          "recalcWhen": 2
        },
        {
          "id": "ModifiePar",
          "label": "Modifié par",
          "type": "Text",
          "formula": "user.Email",
          "recalcWhen": 2
        }
      ]
    }
  ],
  "dependances": [
    "UTILISATEURS"
  ]
}
